
rules_version = '2';

/*
 * ============================================================
 * ActiGallery - Firestore Security Rules
 * Version: 1.0.0
 *
 * Architecture:
 *   Frontend       -> Firebase Callable Functions
 *   Cloud Functions -> Firebase Admin SDK -> Firestore
 *
 * Collections:
 *   users
 *   organizations
 *   categories
 *   albums
 *   photos
 *   system
 *
 * Security policy:
 *   - Deny all direct client reads and writes.
 *   - All access must pass through Cloud Functions.
 *   - Cloud Functions must validate authentication,
 *     authorization, input data, and resource ownership.
 *   - Firebase Admin SDK bypasses Firestore Security Rules.
 * ============================================================
 */

service cloud.firestore {
  match /databases/{database}/documents {

    /*
     * User accounts and roles.
     * Includes admin and album_manager profiles.
     */
    match /users/{userId} {
      allow read, write: if false;
    }

    /*
     * Organization information and logos.
     */
    match /organizations/{organizationId} {
      allow read, write: if false;
    }

    /*
     * Activity album categories.
     */
    match /categories/{categoryId} {
      allow read, write: if false;
    }

    /*
     * Activity albums and publication status.
     */
    match /albums/{albumId} {
      allow read, write: if false;
    }

    /*
     * Photo metadata and album photo ordering.
     */
    match /photos/{photoId} {
      allow read, write: if false;
    }

    /*
     * System settings and internal configuration.
     */
    match /system/{documentId} {
      allow read, write: if false;
    }

    /*
     * Default-deny policy for every other collection,
     * nested document, and future collection.
     */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
